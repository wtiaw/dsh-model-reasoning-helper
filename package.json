{
  "name": "dsh-model-reasoning-helper",
  "version": "0.1.0",
  "description": "DSH settings helper for per-model reasoning effort configuration",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.mjs",
    "./catalog": "./catalog.mjs",
    "./validation": "./validation.mjs",
    "./settings": "./settings.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.mjs",
    "client-core.mjs",
    "view.mjs",
    "catalog.mjs",
    "validation.mjs",
    "settings.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test *.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wtiaw/dsh-model-reasoning-helper.git"
  },
  "bugs": {
    "url": "https://github.com/wtiaw/dsh-model-reasoning-helper/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "react": "^18.3.1"
  }
}
